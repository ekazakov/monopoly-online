# {{ ansible_managed }}
# Production settings. Mode 0600: this file has secrets.
# GAME_SEED and PRESENCE_GRACE_MS are test settings and are never set here.
NODE_ENV=production
GUEST_SIGN_IN_ENABLED=false
DEBUG_MODE_ENABLED=false
LOG_LEVEL={{ app_log_level }}

GOOGLE_CLIENT_ID={{ app_google_client_id }}
GOOGLE_CLIENT_SECRET={{ app_google_client_secret }}
GOOGLE_REDIRECT_URI={{ app_google_redirect_uri }}
{% if app_otel_endpoint | length > 0 %}

# Telemetry to Grafana Cloud. The API sends nothing without the endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT={{ app_otel_endpoint }}
OTEL_EXPORTER_OTLP_HEADERS={{ app_otel_headers }}
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG={{ app_otel_traces_sampler_arg }}
{% endif %}
