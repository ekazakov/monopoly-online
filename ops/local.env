# Settings of the local stack (`docker compose up`). Not secret. Put your own values in `.env` in the
# repository root: it is read after this file, is not committed, and wins.
#
# The image is the production image, but it runs on http://localhost, so it runs in development mode:
# the session cookie is not `Secure`, and the guest sign-in works. To sign in with Google instead,
# set these in `.env`:
#   NODE_ENV=production
#   GUEST_SIGN_IN_ENABLED=false
#   DEBUG_MODE_ENABLED=false
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
NODE_ENV=development
GUEST_SIGN_IN_ENABLED=true
# Debug mode: the debug panel and the debug edits. The API refuses to start with it on in production.
DEBUG_MODE_ENABLED=true
