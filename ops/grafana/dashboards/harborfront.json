    {
      "id": 2,
      "type": "stat",
      "title": "Open streams",
      "description": "Event streams (SSE) open now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(harborfront_realtime_streams_open) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connected devices",
