{
  "name": "@monopoly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development GUEST_SIGN_IN_ENABLED=true DEBUG_MODE_ENABLED=true node --env-file-if-exists=.env --import ./src/telemetry.ts --watch src/index.ts",
    "build": "vp pack",
    "start": "node --env-file-if-exists=.env --import ./dist/telemetry.mjs dist/index.mjs",
    "test": "vp test",
    "openapi": "node scripts/generate-openapi.ts",
    "db:purge": "node scripts/purge-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/instrumentation-runtime-node": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "arctic": "catalog:",
    "better-sqlite3": "catalog:",
    "hono": "catalog:",
    "import-in-the-middle": "catalog:",
    "kysely": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@monopoly/game-engine": "workspace:*",
    "@monopoly/shared": "workspace:*",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
