# Secrets and data: never in an image or in the build context.
.env
.env.*
!.env.example
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/data/
apps/e2e/.data

# Built or installed on the image.
**/node_modules
**/dist
**/dist-ssr

# Test results and reports.
apps/e2e/test-results
apps/e2e/playwright-report
apps/e2e/blob-report
**/coverage

# Not needed to build the app.
.git
.claude
.groma
.history
.idea
.vscode
.ua
.mcp.json
.DS_Store
artifacts
plan
*.log
