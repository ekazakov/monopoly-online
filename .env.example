# Copy to `.env` for your own settings. `.env` is not committed.
# `docker compose` reads it after `ops/local.env`, and `pnpm --filter @monopoly/api dev|start`
# read `apps/api/.env`, which has the same names.

# Sign in with Google instead of the guest names (see ops/local.env).
# NODE_ENV=production
# GUEST_SIGN_IN_ENABLED=false
# DEBUG_MODE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# More logs.
# LOG_LEVEL=debug

# Debug mode: the debug panel and the debug edits. Off when unset. It must be off (or unset) when
# NODE_ENV is production, or the API does not start.
DEBUG_MODE_ENABLED=true
