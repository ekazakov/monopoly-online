{
  "name": "monopoly-online",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "pnpm --filter @monopoly/web dev",
    "dev:api": "pnpm --filter @monopoly/api dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "e2e": "pnpm --filter @monopoly/e2e e2e",
    "e2e:ui": "pnpm --filter @monopoly/e2e e2e:ui",
    "e2e:video": "E2E_VIDEO=1 pnpm --filter @monopoly/e2e e2e",
    "check": "vp check",
    "fmt": "vp fmt",
    "artifact:game-screen": "node artifacts/serve.mjs game-screen 8791",
    "artifact:design-system": "node artifacts/serve.mjs design-system 8792",
    "ready": "vp check && vp run -r test && vp run -r build",
    "openapi": "node apps/api/scripts/generate-openapi.ts",
    "db:purge": "pnpm --filter @monopoly/api db:purge",
    "graph:dashboard": "export GRAPH_DIR=\"$PWD\" && cd ~/.claude/plugins/cache/understand-anything/understand-anything/2.9.8/packages/dashboard && npx vite --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
